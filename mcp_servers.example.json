{
  "servers": [
    {
      "name": "web-search",
      "command": "python",
      "args": ["servers/web_search_mcp.py"],
      "env": {
        "SEARCH_API_KEY": "replace-me"
      },
      "transport": "stdio"
    },
    {
      "name": "mysql",
      "command": "python",
      "args": ["servers/mysql_mcp.py"],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASSWORD": "replace-me",
        "MYSQL_DATABASE": "replace-me"
      },
      "transport": "stdio"
    }
  ]
}
